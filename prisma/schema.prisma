generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")

}

model User {
  id          String   @id   //ユーザー識別ID

  email       String   @unique  
  username    String   @unique // URL用 重複禁止
  displayName String   // 表示名

  xAccount  String?
  avatarUrl   String?  //プロフィール画像URL

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  messages Message[] @relation("ReceivedMessages") //このユーザー宛に届いたメッセージ一覧
  ngWords NGWord[]
}

model Message {
  id   String @id @default(uuid())

  receiverId   String 
  receiver User @relation("ReceivedMessages", fields: [receiverId], references: [id])  //誰宛のメッセージかの識別
  senderGuestId  String?  

  content   String?
  imageUrl   String? //メッセージとイラストどちらかはNULL可

  isRead   Boolean @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([receiverId])  //検索高速化

}

model NGWord {
  id      String @id @default(uuid())
  userId   String
  user      User @relation(fields: [userId], references: [id])
  word   String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt 
}

